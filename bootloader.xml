<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="baydroid" fetch="git@github.com:BayLibre/"/>
  <default remote="baydroid" sync-j="4"/>

  <!-- SpacemiT bootloader chains. See the manifest repo README for the
       workflow; the entry point for both boards is
       build-bootloaders/release_android.sh.

       The board yaml selects the source trees. The K1 config has no src
       keys and falls back to the pi-u-boot and pi-opensbi vendor forks
       below (U-Boot 2022.10, OpenSBI 1.3). The K3 config points at
       upstream U-Boot and upstream OpenSBI instead.

       The riscv64 toolchain is downloaded on first build by
       build-bootloaders/utils.sh. Outputs are staged into the AOSP tree
       under vendor/spacemit/BOARD/bootloader/.
  -->
  <project path="build-bootloaders" name="android_bootloader_build" revision="spacemit-android-16"/>

  <!-- K1: Banana Pi F3 and MusePi Pro, vendor 2022.10 chain -->
  <project path="pi-u-boot"  name="pi-u-boot"  revision="v2022.10-k1"/>
  <project path="pi-opensbi" name="pi-opensbi" revision="v1.3-k1"/>

  <!-- The K3 chain is built from upstream U-Boot 2026.07 and upstream
       OpenSBI, each carrying local commits on a k3-port branch. Those
       trees are not published yet, so they cannot be declared here; they
       are provisioned by hand until BayLibre forks exist. See the docs. -->

</manifest>
