<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="baydroid" fetch="git@github.com:BayLibre/"/>
  <default remote="baydroid" sync-j="4"/>

  <!-- Banana Pi F3 / SpacemiT K1 bootloader chain.
       See the manifest repo README for the workflow; the entry point
       is build-bootloaders/release_android.sh.
       The Bootlin riscv64 toolchain is downloaded on first build
       (utils.sh: download_riscv64_toolchain), outputs are staged
       into aosp/vendor/spacemit/k1/bootloader/.
  -->
  <project path="build-bootloaders" name="android_bootloader_build" revision="ti-android-16"/>
  <project path="pi-u-boot"         name="pi-u-boot"                revision="v2022.10-k1"/>
  <project path="pi-opensbi"        name="pi-opensbi"               revision="v1.3-k1"/>
</manifest>
