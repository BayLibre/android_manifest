<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Spelled out in full: this manifest is not hosted on
       android.googlesource.com, so upstream's relative fetch=".."
       would resolve against the BayLibre remote instead. -->
  <remote name="aosp" fetch="https://android.googlesource.com/" review="https://android-review.googlesource.com/"/>
  <remote name="baydroid" fetch="git@github.com:BayLibre/"/>
  <default revision="main-kernel" remote="aosp" sync-j="4"/>
  <superproject name="kernel/superproject" remote="aosp" revision="common-android-mainline-riscv64"/>
  <project path="build/kernel" name="kernel/build" groups="ddk">
    <linkfile src="kleaf/bazel.sh" dest="tools/bazel"/>
    <linkfile src="kleaf/bzlmod/bazel.MODULE.bazel" dest="MODULE.bazel"/>
  </project>
  <project path="common" name="kernel/common" revision="android-mainline-riscv64"/>
  <project path="common-modules/wonder" name="kernel/common-modules/wonder" revision="android-mainline"/>
  <project path="common-modules/trusty" name="kernel/common-modules/trusty"/>
  <project path="common-modules/virtio-media" name="platform/external/virtio-media"/>
  <project path="common-modules/virtual-device" name="kernel/common-modules/virtual-device" revision="android-mainline-riscv64"/>
  <project path="devices/google/raviole" name="kernel/devices/google/raviole" revision="android-gs-raviole-mainline"/>
  <project path="prebuilts/clang/host/linux-x86" name="platform/prebuilts/clang/host/linux-x86" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" name="platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/build-tools" name="platform/prebuilts/build-tools" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/clang-tools" name="platform/prebuilts/clang-tools" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/kernel-build-tools" name="kernel/prebuilts/build-tools" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/rust-toolchain/linux-x86" name="platform/prebuilts/rust-toolchain/linux-x86" clone-depth="1" groups="ddk"/>
  <project path="prebuilts/ndk-r27" name="toolchain/prebuilts/ndk/r27" clone-depth="1" groups="ddk"/>

  <!-- Dependencies for testing (kunit, kselftests, ltp) -->
  <!-- Uncomment for local testing only -->
  <!-- project path="kernel/tests" name="kernel/tests" revision="main-kernel" clone-depth="1" / -->
  <project path="prebuilts/jdk/jdk11" name="platform/prebuilts/jdk/jdk11" clone-depth="1"/>
  <project path="external/libcap-ng" name="platform/external/libcap-ng"/>
  <project path="external/libcap" name="platform/external/libcap"/>
  <project path="test/ltp" name="platform/external/ltp"/>

  <!-- deps for for bzlmod -->
  <project path="external/bazel-contrib-bazel_features" name="platform/external/bazel-contrib-bazel_features" groups="ddk-external"/>
  <project path="external/bazel-contrib-rules_devicetree" name="platform/external/bazel-contrib-rules_devicetree" groups="ddk-external"/>
  <project path="external/bazel-contrib-supply-chain" name="platform/external/bazel-contrib-supply-chain" groups="ddk-external"/>
  <project path="external/bazel-skylib" name="platform/external/bazel-skylib" groups="ddk-external"/>
  <project path="external/bazelbuild-bazel-central-registry" name="platform/external/bazelbuild-bazel-central-registry" groups="ddk-external"/>
  <project path="external/bazelbuild-platforms" name="platform/external/bazelbuild-platforms" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_cc" name="platform/external/bazelbuild-rules_cc" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_license" name="platform/external/bazelbuild-rules_license" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_pkg" name="platform/external/bazelbuild-rules_pkg" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_python" name="platform/external/bazelbuild-rules_python" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_rust" name="platform/external/bazelbuild-rules_rust" groups="ddk-external"/>
  <project path="external/bazelbuild-rules_shell" name="platform/external/bazelbuild-rules_shell" groups="ddk-external"/>
  <project path="external/python/absl-py" name="platform/external/python/absl-py" groups="ddk-external"/>

  <!-- local_repository()'s dependencies -->
  <!-- Present on common-android-mainline but missing from
       common-android-mainline-riscv64, which lags behind it. The kleaf
       MODULE.bazel declares all three as local_repository, so the build
       fails outright without them. -->
  <project path="external/abseil-cpp" name="platform/external/abseil-cpp" groups="ddk"/>
  <project path="external/protobuf" name="platform/external/protobuf" groups="ddk"/>
  <project path="external/stg" name="platform/external/stg" groups="ddk"/>
  <project path="external/argp-standalone" name="platform/external/argp-standalone" groups="ddk"/>
  <project path="external/avb" name="platform/external/avb" groups="ddk"/>
  <project path="external/dtc" name="platform/external/dtc" groups="ddk"/>
  <project path="external/dwarves" name="platform/external/dwarves" groups="ddk"/>
  <project path="external/kmod" name="platform/external/kmod" groups="ddk"/>
  <project path="external/lz4" name="platform/external/lz4" groups="ddk"/>
  <project path="external/obstack" name="platform/external/obstack" groups="ddk"/>
  <project path="external/pigz" name="platform/external/pigz" groups="ddk"/>
  <project path="external/toybox" name="platform/external/toybox" groups="ddk"/>
  <project path="external/zlib" name="platform/external/zlib" groups="ddk"/>
  <project path="external/zopfli" name="platform/external/zopfli" groups="ddk"/>
  <project path="external/zstd" name="platform/external/zstd" groups="ddk"/>

  <!-- dependencies for GBL -->
  <project path="bootable/libbootloader" name="platform/bootable/libbootloader" revision="gbl-mainline"/>
  <project path="external/arm-trusted-firmware" name="platform/external/arm-trusted-firmware"/>
  <project path="external/boringssl" name="platform/external/boringssl"/>
  <project path="external/compiler-rt" name="platform/external/compiler-rt"/>
  <project path="external/libufdt" name="platform/system/libufdt"/>
  <project path="external/open-dice" name="platform/external/open-dice"/>
  <project path="external/elfutils" name="platform/external/elfutils"/>
  <project path="external/googletest" name="platform/external/googletest"/>
  <project path="external/mtools" name="platform/external/mtools"/>
  <project path="external/rust/android-crates-io" name="platform/external/rust/android-crates-io"/>
  <project path="prebuilts/fuchsia_sdk" name="platform/prebuilts/fuchsia_sdk" clone-depth="1" revision="gbl-mainline"/>
  <project path="prebuilts/vmm" name="device/google/cuttlefish_vmm" clone-depth="1" />

  <!-- dependencies for u-boot -->
  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" name="platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" clone-depth="1" />
  <project path="prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9" name="platform/prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9" clone-depth="1" />
  <project path="u-boot" name="platform/external/u-boot" revision="u-boot-mainline" />
  <!-- ==================================================================
       BayLibre SpacemiT overrides: drop the Pixel raviole device, swap
       kernel/common for the fork carrying the SpacemiT K1 and K3 deltas.

       common tracks android-mainline (Linux 7.1+) rather than the ACK
       android17-6.18: the K3 SoC base (k3.dtsi, ccu-k3, K3 pinctrl) landed
       upstream in Linux 7.0/7.1 and is absent from 6.18, which also lacks
       k1-musepi-pro.dts. See docs/ for the ACK evaluation.
       ================================================================== -->
  <!-- The riscv64 branch maps external/zlib to platform/external/zlib,
       which carries no bazel marker file. kleaf declares zlib as a
       bzlmod bazel_dep with a local_path_override, so it needs a real
       MODULE.bazel. common-android-mainline maps the same path to
       zlib-madler, which has one. -->
  <remove-project name="platform/external/zlib" />
  <project path="external/zlib" name="platform/external/zlib-madler" groups="ddk"/>

  <remove-project name="kernel/common" />
  <project path="common" name="android_kernel_common" remote="baydroid" revision="android-mainline-spacemit"/>

  <remove-project name="kernel/devices/google/raviole" />
  <project path="devices/spacemit" name="android_kernel_device_spacemit" remote="baydroid" revision="android-mainline-riscv64">
    <!-- TODO: flip to spacemit_soc/device.bazelrc once the
         bananapi_f3 -> spacemit_soc rename lands on the remote branch. -->
    <linkfile src="bananapi_f3/device.bazelrc" dest="device.bazelrc"/>
  </project>
</manifest>
